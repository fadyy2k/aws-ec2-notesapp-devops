[Unit]
Description=Notes App (Flask via Gunicorn)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/notesapp

# Environment variables (edit DB_PASS after deployment)
Environment=DB_HOST=localhost
Environment=DB_USER=notesuser
Environment=DB_PASS=ChangeMe_StrongPassword
Environment=DB_NAME=notesdb

ExecStart=/opt/notesapp/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
